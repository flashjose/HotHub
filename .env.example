# 生产环境变量模板
#
#   cp .env.example .env    然后按需填写
#
# .env 已被 .gitignore 排除，不会提交。docker compose 会自动读取同目录的
# .env 并替换 docker-compose.yml 里的 ${VAR} 占位符。

# --- Cookie 池 -------------------------------------------------------------
# 微博等平台不带 Cookie 抓取会掉数据。JSON 格式，按域名分配，"*" 为兜底。
# 留空则不带 Cookie（CookiePool 自动退化，不会报错）。
# COOKIE_POOL={"weibo.com":["SUB=xxx; SUBP=yyy"],"*":["fallback"]}

# 轮换策略：round_robin | random
# COOKIE_STRATEGY=round_robin

# --- 缓存 ------------------------------------------------------------------
# 成功结果的缓存时长（秒）。调大可减少对目标站点的请求频率。
# CACHE_TTL_SECONDS=900

# 抓取失败的缓存时长（秒）。故意设得很短，避免一次网络抖动就把某个平台
# 钉死在"不可用"状态整整 CACHE_TTL_SECONDS。
# ERROR_CACHE_TTL_SECONDS=30

# --- 抓取行为 --------------------------------------------------------------
# REQUEST_TIMEOUT_SECONDS=8
# REQUEST_MAX_RETRIES=2
# MIN_REQUEST_INTERVAL_SECONDS=1.0
